{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rescout.schema.json",
  "title": "rescout-{session}.json",
  "description": "Step 7.x targeted rescout output. Merged into screened-{session}.json by merge-scout-findings.py. See apex-core.md step 7.x.",
  "type": "object",
  "required": ["found"],
  "properties": {
    "found": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "reason"],
        "properties": {
          "file": { "type": "string" },
          "reason": { "type": "string" },
          "line_range": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } }
            ]
          }
        }
      }
    }
  }
}
