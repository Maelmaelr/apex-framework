{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screened.schema.json",
  "title": "{session}-screened.json",
  "description": "Step 6 screener output. Single Sonnet call; keep / drop with free-text reason per file. See apex-core.md step 6 / agents/screener.md.",
  "type": "object",
  "required": ["kept", "dropped"],
  "properties": {
    "kept": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "screener_reason"],
        "properties": {
          "file": { "type": "string" },
          "screener_reason": { "type": "string", "description": "Free-text keep justification" }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "screener_reason"],
        "properties": {
          "file": { "type": "string" },
          "screener_reason": { "type": "string", "description": "Free-text drop justification" }
        }
      }
    },
    "_meta": {
      "type": "object",
      "properties": {
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
