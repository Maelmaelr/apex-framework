{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fix-attempts.schema.json",
  "title": "{session}-fix-attempts.json",
  "description": "Counter for step 10 verify-fix attempts. Cap = 3. See apex-core.md step 10.",
  "type": "object",
  "required": ["count"],
  "properties": {
    "count": { "type": "integer", "minimum": 0, "maximum": 3 },
    "last_attempt_at": { "type": "string", "format": "date-time" },
    "last_errors_path": { "type": "string", "description": "Usually .claude-tmp/apex-active/{session}-verify-errors.txt" }
  }
}
