{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fix-attempts.schema.json",
  "title": "{session}-fix-attempts-{context}.json",
  "description": "Counter for verify+fix attempts. Contexts: main (Path 1 p1.2), p2 (central Path 2 p2.3). Cap = 3. See apex-core.md p1.2 / p2.3.",
  "type": "object",
  "required": ["count"],
  "properties": {
    "count": { "type": "integer", "minimum": 0, "maximum": 3 },
    "last_attempt_at": { "type": "string", "format": "date-time" },
    "last_errors_path": { "type": "string", "description": "Usually .claude-tmp/apex-active/{session}-verify-errors.txt" }
  }
}
