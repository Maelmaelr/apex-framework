{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preflight.schema.json",
  "title": "preflight-{session}.json",
  "description": "Step 7 output. Drives Path 1/2 decision and 7.x rescout gate. See apex-core.md step 7.",
  "type": "object",
  "required": ["missed_regions", "effective_blast", "mode"],
  "properties": {
    "missed_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "reason"],
        "properties": {
          "file": { "type": "string" },
          "line_range": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } }
            ]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "effective_blast": { "enum": ["small", "large"] },
    "mode": { "enum": ["medium", "complex"] },
    "_meta": {
      "type": "object",
      "properties": {
        "dropped_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
