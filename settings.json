{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/scope-check-hook.sh" },
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/protect-env-hook.sh" },
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/file-health-hook.sh" },
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/step-read-gate-hook.sh" }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/protect-env-hook.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/block-destructive-hook.sh" },
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/step-read-gate-hook.sh" }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/step-read-gate-hook.sh" }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/step-read-gate-hook.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/step-read-gate-hook.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/skills/apex/scripts/session-end-hook.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash ~/.claude/skills/apex/scripts/*.sh:*)",
      "Bash(bash ~/.claude/skills/apex/scripts/*.py:*)",
      "Bash(bash ~/.claude/skills/admin-apex/scripts/*.sh:*)",
      "Bash(bash ~/.claude/skills/admin-apex/scripts/*.py:*)",
      "Bash(openssl rand -hex *:*)",
      "Bash(git rev-parse HEAD:*)",
      "Bash(git diff:*)",
      "Bash(git diff --name-only:*)",
      "Bash(git diff --shortstat:*)",
      "Bash(git diff --stat:*)",
      "Bash(git diff --staged:*)",
      "Bash(git diff --staged --stat:*)",
      "Bash(git ls-files --others --exclude-standard:*)",
      "Bash(git check-ignore:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(flock:*)",
      "Bash(jq:*)",
      "Bash(realpath:*)",
      "Bash(wc -l:*)",
      "Bash(wc -c:*)",
      "Bash(ps -o comm= -p *:*)",
      "Bash(ps -o pid,ppid,command -p *:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.development)",
      "Edit(.env*)",
      "Write(.env*)"
    ]
  }
}
